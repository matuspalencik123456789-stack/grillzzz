# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://grillz:grillz@localhost:5432/grillz_studio?schema=public"

# ── Redis (queues, cache, rate limiting) ───────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── S3-compatible object storage (MinIO in dev) ────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="grillz-studio"
S3_ACCESS_KEY_ID="grillz"
S3_SECRET_ACCESS_KEY="grillz-secret"
S3_FORCE_PATH_STYLE="true"

# ── Backend API ─────────────────────────────────────────────────────────────
API_PORT=4000
API_CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="change-me-in-production-min-32-characters!!"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
AUTH_SECRET="change-me-in-production-min-32-characters!!"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Payments ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── AI provider (Anthropic). Empty key => deterministic rules-engine fallback
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# ── Containerized deploys only (docker compose --profile full) ─────────────
# Public origins as seen from the browser. See docs/DEPLOYMENT.md.
# PUBLIC_API_URL="https://api.example.com"
# PUBLIC_APP_URL="https://app.example.com"
# Server-side API origin inside the docker network (set by compose):
# API_INTERNAL_URL="http://backend:4000"
